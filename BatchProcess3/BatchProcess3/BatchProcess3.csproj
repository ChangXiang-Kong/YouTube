<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Controls.DataGrid" />
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="ClassicDiagnostics.Avalonia" />
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="System.Drawing.Common" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Controls\Styles\Basic\Fonts.axaml" />
      <AdditionalFiles Include="Controls\Styles\General.axaml" />
      <AdditionalFiles Include="Controls\Styles\Labels.axaml" />
      <AdditionalFiles Include="Controls\Styles\ListBox.axaml" />
      <AdditionalFiles Include="Controls\Styles\TextBlock.axaml" />
      <AdditionalFiles Include="Controls\Styles\TextBox.axaml" />
    </ItemGroup>

    <ItemGroup>
      <PackageVersion Update="Avalonia.Controls.DataGrid" Version="12.1.2" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="EntityFramework\Dtos\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\MainMenus\ActionsPageView.axaml.cs">
        <DependentUpon>ActionsPageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainMenus\HistoryPageView.axaml.cs">
        <DependentUpon>HistoryPageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainMenus\HomePageView.axaml.cs">
        <DependentUpon>HomePageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainMenus\MacrosPageView.axaml.cs">
        <DependentUpon>MacrosPageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainMenus\ProcessPageView.axaml.cs">
        <DependentUpon>ProcessPageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainMenus\ReporterPageView.axaml.cs">
        <DependentUpon>ReporterPageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainMenus\SettingsPageView.axaml.cs">
        <DependentUpon>SettingsPageView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Actions\PrintSettingsView.axaml.cs">
        <DependentUpon>PrintProfileView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
</Project>
