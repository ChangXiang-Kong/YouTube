<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="ClassicDiagnostics.Avalonia" />
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Controls\Styles\Basic\Fonts.axaml" />
      <AdditionalFiles Include="Controls\Styles\General.axaml" />
      <AdditionalFiles Include="Controls\Styles\Labels.axaml" />
      <AdditionalFiles Include="Controls\Styles\ListBox.axaml" />
      <AdditionalFiles Include="Controls\Styles\TextBlock.axaml" />
      <AdditionalFiles Include="Controls\Styles\TextBox.axaml" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\PrintProfileView.axaml.cs">
        <DependentUpon>PrinterSettingsView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
</Project>
