<UserControl x:Class="BatchProcess3.Views.Actions.ActionsTabFileInfoView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ava="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mainMenus="clr-namespace:BatchProcess3.ViewModels.MainMenus"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             xmlns:vmActions="clr-namespace:BatchProcess3.ViewModels.Actions"
             d:DesignHeight="620"
             d:DesignWidth="1000"
             x:DataType="mainMenus:ActionsPageViewModel"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             mc:Ignorable="d">
  <Design.DataContext>
    <mainMenus:ActionsPageViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="*, 30, 3*">
    <!--  File Info List Column  -->
    <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
      <Label Classes="h2" Content="File Info Actions" />
      <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="File Info actions can be used to set, update or clear file properties." TextWrapping="Wrap" />
      <Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Classes="small outline"
              Command="{Binding AddNewFileInfoItemCommand}"
              Content="New File Info Action" />
      <!--  绑定Model中的Id而不是Model本身  -->
      <ListBox Grid.Row="6"
               ItemsSource="{Binding FileInfoList}"
               SelectedValue="{Binding SelectedFileInfoItemId}"
               SelectedValueBinding="{Binding Id}"
               SelectionChanged="SelectingItemsControl_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vmActions:ActionsTabFileInfoViewModel">
            <Grid ColumnDefinitions="*, Auto">
              <Label Grid.Column="0" VerticalAlignment="Center" Content="{Binding JobName}" FontWeight="{Binding HasChanged, Converter={StaticResource BoolToBoldFontConverter}}" />
              <Button Grid.Column="1" Margin="0,0,-8,0" Padding="0"
                      VerticalAlignment="Center" ava:ToolTip.Tip="Delete" Classes="smaller danger"
                      Command="{Binding $parent[ListBox].((mainMenus:ActionsPageViewModel)DataContext).DeleteFileInfoItemCommand}"
                      CommandParameter="{Binding Id}">
                <Button.IsVisible>
                  <MultiBinding Converter="{StaticResource BoolOrMultiConverter}">
                    <Binding Path="$parent[ListBoxItem].IsPointerOver" />
                    <Binding Path="$parent[ListBoxItem].IsSelected" />
                  </MultiBinding>
                </Button.IsVisible>
                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="{Binding !FileInfoListHasItems}"
                Spacing="10">
      <StackPanel.Styles>
        <Style Selector="StackPanel">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
          </Setter>
        </Style>
      </StackPanel.Styles>

      <TextBlock HorizontalAlignment="Center" Text="File Info actions can be used to set, update or clear file properties." />
      <TextBlock HorizontalAlignment="Center" Text="To get started, create a new File Info Action." />
      <Button Margin="10" HorizontalAlignment="Center" Command="{Binding AddNewFileInfoItemCommand}" Content="New File Info Action" />
    </StackPanel>

    <Grid Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding FileInfoListHasItems}">
      <Grid.Styles>
        <Style Selector="Grid">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
          </Setter>
        </Style>
      </Grid.Styles>

      <!--  General Settings Column  -->
      <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, *">
        <Label Grid.Row="0" Classes="h2" Content="General Settings" />
        <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Set the main properties of the File Info job." />
        <Grid Grid.Row="4" ColumnDefinitions="130, 10, *" RowDefinitions="Auto, 10, Auto">
          <!--  Job Name  -->
          <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="Job Name" />
          <TextBox Name="TextBox_JobName" Grid.Row="0" Grid.Column="2"
                   Text="{Binding SelectedFileInfoItem.JobName}"
                   ToolTip.Tip="{Binding SelectedFileInfoItem.JobName}" />
          <!--  Description  -->
          <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Content="Description" />
          <TextBox Grid.Row="2" Grid.Column="2" Height="90"
                   AcceptsReturn="True"
                   Text="{Binding SelectedFileInfoItem.Description}"
                   TextWrapping="Wrap" />
        </Grid>

        <!--  Details  -->
        <Label Grid.Row="6" Classes="h2" Content="Details" />
        <TextBlock Grid.Row="8" Margin="0,-10,0,0" Text="Specify the additional details." TextWrapping="Wrap" />
        <Grid Grid.Row="10" ColumnDefinitions="130, 10, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
          <!--  Title  -->
          <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="Title" />
          <TextBox Grid.Row="0" Grid.Column="2" Margin="0,5"
                   Text="{Binding SelectedFileInfoItem.Title}"
                   ToolTip.Tip="{Binding SelectedFileInfoItem.Title}" />
          <!--  Subject  -->
          <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="Subject" />
          <TextBox Grid.Row="1" Grid.Column="2" Margin="0,5"
                   Text="{Binding SelectedFileInfoItem.Subject}"
                   ToolTip.Tip="{Binding SelectedFileInfoItem.Subject}" />
          <!--  Author  -->
          <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Content="Author" />
          <TextBox Grid.Row="2" Grid.Column="2" Margin="0,5"
                   Text="{Binding SelectedFileInfoItem.Author}"
                   ToolTip.Tip="{Binding SelectedFileInfoItem.Author}" />
          <!--  Keywords  -->
          <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Content="Keywords" />
          <TextBox Grid.Row="3" Grid.Column="2" Margin="0,5"
                   Text="{Binding SelectedFileInfoItem.Keywords}"
                   ToolTip.Tip="{Binding SelectedFileInfoItem.Keywords}" />
          <!--  Comments  -->
          <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Content="Comments" />
          <TextBox Grid.Row="4" Grid.Column="2" Height="90"
                   Margin="0,5" AcceptsReturn="True"
                   Text="{Binding SelectedFileInfoItem.Comments}"
                   ToolTip.Tip="{Binding SelectedFileInfoItem.Comments}" />
        </Grid>
      </Grid>

      <!--  Details Column  -->
      <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
        <Label Grid.Row="0" Classes="h2" Content="Details" />
        <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Specify the additional details." TextWrapping="Wrap" />

        <!--  Extra details here  -->
        <StackPanel Grid.Row="4" />

        <!--  Save and Cancel state Button  -->
        <StackPanel Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Opacity="{Binding SelectedFileInfoItem.HasChanged, FallbackValue=0}"
                    Orientation="Horizontal" Spacing="10">
          <!--
            FallbackValue = 绑定失败时的 “备胎值” ，当绑定找不到对象、找不到值、或者值为 null 时 → 自动使用 FallbackValue 指定的值。
            场景 1：绑定对象可能为 null                      例如：SelectedPrintListItem 没选中时 = null → 便用 FallbackValue 给一个默认值
            场景 2：界面设计时（Designer 预览）              Designer 里没有 DataContext → 绑定全部失败 → 使用 FallbackValue 让界面显示正常
            场景 3：值类型不能为 null（bool /int/double）    如果绑定的是 bool，但对象是 null → 无法转换 → 使用 FallbackValue 提供默认值
          -->
          <!--  注意：WPF 与 Avalonia 的 IsVisible 不能绑定动画。Avalonia已经内置了 BoolToDouble值转换器，因此上面的 Opacity 可以直接绑定 HasChanged 布尔值  -->
          <StackPanel.Styles>
            <Style Selector="StackPanel">
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
              </Setter>
            </Style>
          </StackPanel.Styles>
          <Button Width="70" HorizontalContentAlignment="Center" Classes="success"
                  Command="{Binding SaveFileInfoItemCommand}"
                  Content="Save" />
          <Button Width="70" HorizontalContentAlignment="Center" Classes="outline"
                  Command="{Binding CancelFileInfoItemCommand}"
                  Content="Cancel" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>

</UserControl>