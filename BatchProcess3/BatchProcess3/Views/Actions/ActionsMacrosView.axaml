<UserControl x:Class="BatchProcess3.Views.Actions.ActionsMacrosView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ava="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             xmlns:vmActions="clr-namespace:BatchProcess3.ViewModels.Actions"
             xmlns:vmMainMenus="clr-namespace:BatchProcess3.ViewModels.MainMenus"
             d:DesignHeight="620"
             d:DesignWidth="1000"
             x:DataType="vmMainMenus:ActionsPageViewModel"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             mc:Ignorable="d">
  <Design.DataContext>
    <vmMainMenus:ActionsPageViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="*, 30, 3*">
    <!--  Macros List Column  -->
    <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
      <Label Classes="h2" Content="Macros Actions" />
      <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Macros actions can be used to run macros on parts, drawings and assemblies." TextWrapping="Wrap" />
      <Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Classes="small outline"
              Command="{Binding MacrosList.AddNewItemCommand}"
              Content="New Macros Action" />
      <!--  绑定Model中的Id而不是Model本身  -->
      <ListBox Grid.Row="6"
               ItemsSource="{Binding MacrosList.ItemsList}"
               SelectedValue="{Binding MacrosList.SelectedItemId}"
               SelectedValueBinding="{Binding Id}"
               SelectionChanged="SelectingItemsControl_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vmActions:ActionsMacrosViewModel">
            <Grid ColumnDefinitions="*, Auto">
              <Label Grid.Column="0" VerticalAlignment="Center" Background="Transparent"
                     Content="{Binding JobName}"
                     FontWeight="{Binding HasChanged, Converter={StaticResource BoolToBoldFontConverter}}"
                     ToolTip.Tip="{Binding JobName}" />
              <Button Grid.Column="1" Margin="0,0,-8,0" Padding="0"
                      VerticalAlignment="Center" ava:ToolTip.Tip="Delete" Classes="smaller danger"
                      Command="{Binding $parent[ListBox].((vmMainMenus:ActionsPageViewModel)DataContext).MacrosList.DeleteItemCommand}"
                      CommandParameter="{Binding Id}">
                <Button.IsVisible>
                  <MultiBinding Converter="{StaticResource BoolOrMultiConverter}">
                    <Binding Path="$parent[ListBoxItem].IsPointerOver" />
                    <Binding Path="$parent[ListBoxItem].IsSelected" />
                  </MultiBinding>
                </Button.IsVisible>
                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Name="StackPanel_NewAction" Grid.Column="2" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding #StackPanel_NewAction.Opacity}"
                Opacity="{Binding !MacrosList.ListHasItems}"
                Spacing="10" ZIndex="10">
      <StackPanel.Styles>
        <Style Selector="StackPanel">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
          </Setter>
        </Style>
      </StackPanel.Styles>

      <TextBlock HorizontalAlignment="Center" Text="Macros actions can be used to run macros on parts, drawings and assemblies." />
      <TextBlock HorizontalAlignment="Center" Text="To get started, create a new Macros Action." />
      <Button Width="350" Margin="10" HorizontalAlignment="Center"
              HorizontalContentAlignment="Center"
              Command="{Binding MacrosList.AddNewItemCommand}"
              Content="New Macros Action" />
    </StackPanel>

    <Grid Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding MacrosList.ListHasItems}">
      <Grid.Styles>
        <Style Selector="Grid">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
          </Setter>
        </Style>
      </Grid.Styles>

      <!--  General Settings Column  -->
      <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, *">
        <Label Grid.Row="0" Classes="h2" Content="General Settings" />
        <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Set the main properties of the Macros job." />
        <Grid Grid.Row="4" ColumnDefinitions="120, 10, 25, 5, *" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, Auto, Auto">
          <!--  Job Name  -->
          <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="Job Name" />
          <TextBox Name="TextBox_JobName" Grid.Row="0" Grid.Column="4"
                   Text="{Binding MacrosList.SelectedItem.JobName}"
                   ToolTip.Tip="{Binding MacrosList.SelectedItem.JobName}" />
          <!--  Description  -->
          <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Content="Description" />
          <TextBox Grid.Row="2" Grid.Column="4" Height="90"
                   AcceptsReturn="True"
                   Text="{Binding MacrosList.SelectedItem.Description}"
                   TextWrapping="Wrap" />

          <!--  Macro Path  -->
          <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Content="Macro Path" />
          <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding MacrosList.SelectedItem.MacroPath}" />

          <!--  Module Name  -->
          <Label Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Content="Module Name" />
          <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding MacrosList.SelectedItem.ModuleName}" />

          <!--  Exclude Parts  -->
          <Label Grid.Row="8" Grid.Column="2" VerticalAlignment="Center"
                 Classes="icon-only icon-outline subtle-hover" Content="&#xE3E8;"
                 ToolTip.Tip="Exclude Parts" />
          <CheckBox Grid.Row="8" Grid.Column="4" Content="Exclude Parts" IsChecked="{Binding MacrosList.SelectedItem.ExcludeParts}" />

          <!--  Exclude Drawings  -->
          <Label Grid.Row="9" Grid.Column="2" VerticalAlignment="Center"
                 Classes="icon-only icon-outline subtle-hover" Content="&#xE3E8;"
                 ToolTip.Tip="Exclude Drawings" />
          <CheckBox Grid.Row="9" Grid.Column="4" Content="Exclude Drawings" IsChecked="{Binding MacrosList.SelectedItem.ExcludeDrawings}" />

          <!--  Exclude Assemblies  -->
          <Label Grid.Row="10" Grid.Column="2" VerticalAlignment="Center"
                 Classes="icon-only icon-outline subtle-hover" Content="&#xE3E8;"
                 ToolTip.Tip="Exclude Assemblies" />
          <CheckBox Grid.Row="10" Grid.Column="4" Content="Exclude Assemblies" IsChecked="{Binding MacrosList.SelectedItem.ExcludeAssemblies}" />
        </Grid>
      </Grid>

      <!--  Details Column  -->
      <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
        <Label Grid.Row="0" Classes="h2" Content="Details" />
        <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Specify the additional details." TextWrapping="Wrap" />

        <!--  Extra details here  -->
        <StackPanel Grid.Row="4" />

        <!--  Save and Cancel state Button  -->
        <StackPanel Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Opacity="{Binding MacrosList.SelectedItem.HasChanged, FallbackValue=0}"
                    Orientation="Horizontal" Spacing="10">
          <!--
            FallbackValue = 绑定失败时的 “备胎值” ，当绑定找不到对象、找不到值、或者值为 null 时 → 自动使用 FallbackValue 指定的值。
            场景 1：绑定对象可能为 null                      例如：SelectedPrintListItem 没选中时 = null → 便用 FallbackValue 给一个默认值
            场景 2：界面设计时（Designer 预览）              Designer 里没有 DataContext → 绑定全部失败 → 使用 FallbackValue 让界面显示正常
            场景 3：值类型不能为 null（bool /int/double）    如果绑定的是 bool，但对象是 null → 无法转换 → 使用 FallbackValue 提供默认值
          -->
          <!--  注意：WPF 与 Avalonia 的 IsVisible 不能绑定动画。Avalonia已经内置了 BoolToDouble值转换器，因此上面的 Opacity 可以直接绑定 HasChanged 布尔值  -->
          <StackPanel.Styles>
            <Style Selector="StackPanel">
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
              </Setter>
            </Style>
          </StackPanel.Styles>
          <Button Width="70" HorizontalContentAlignment="Center" Classes="success"
                  Command="{Binding MacrosList.SaveItemCommand}"
                  Content="Save" />
          <Button Width="70" HorizontalContentAlignment="Center" Classes="outline"
                  Command="{Binding MacrosList.CancelItemCommand}"
                  Content="Cancel" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>

</UserControl>