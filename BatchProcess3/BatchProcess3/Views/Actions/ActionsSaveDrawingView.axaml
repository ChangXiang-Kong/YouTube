<UserControl x:Class="BatchProcess3.Views.Actions.ActionsSaveDrawingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ava="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             xmlns:vmActions="clr-namespace:BatchProcess3.ViewModels.Actions"
             xmlns:vmMainMenus="clr-namespace:BatchProcess3.ViewModels.MainMenus"
             d:DesignHeight="620"
             d:DesignWidth="1000"
             x:DataType="vmMainMenus:ActionsPageViewModel"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             mc:Ignorable="d">
  <Design.DataContext>
    <vmMainMenus:ActionsPageViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="*, 30, 3*">
    <!--  SaveDrawing List Column  -->
    <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
      <Label Classes="h2" Content="Save Drawing Actions" />
      <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Save Drawing actions can be used to export drawings in various formats." TextWrapping="Wrap" />
      <Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Classes="small outline"
              Command="{Binding AddNewSaveDrawingItemCommand}"
              Content="New Save Drawing Action" />
      <!--  绑定Model中的Id而不是Model本身  -->
      <ListBox Grid.Row="6"
               ItemsSource="{Binding SaveDrawingList}"
               SelectedValue="{Binding SelectedSaveDrawingItemId}"
               SelectedValueBinding="{Binding Id}"
               SelectionChanged="SelectingItemsControl_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vmActions:ActionsSaveDrawingViewModel">
            <Grid ColumnDefinitions="*, Auto">
              <Label Grid.Column="0" VerticalAlignment="Center" Background="Transparent"
                     Content="{Binding JobName}"
                     FontWeight="{Binding HasChanged, Converter={StaticResource BoolToBoldFontConverter}}"
                     ToolTip.Tip="{Binding JobName}" />
              <Button Grid.Column="1" Margin="0,0,-8,0" Padding="0"
                      VerticalAlignment="Center" ava:ToolTip.Tip="Delete" Classes="smaller danger"
                      Command="{Binding $parent[ListBox].((vmMainMenus:ActionsPageViewModel)DataContext).DeleteSaveDrawingItemCommand}"
                      CommandParameter="{Binding Id}">
                <Button.IsVisible>
                  <MultiBinding Converter="{StaticResource BoolOrMultiConverter}">
                    <Binding Path="$parent[ListBoxItem].IsPointerOver" />
                    <Binding Path="$parent[ListBoxItem].IsSelected" />
                  </MultiBinding>
                </Button.IsVisible>
                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Name="StackPanel_NewAction" Grid.Column="2" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding #StackPanel_NewAction.Opacity}"
                Opacity="{Binding !SaveDrawingListHasItems}"
                Spacing="10" ZIndex="10">
      <StackPanel.Styles>
        <Style Selector="StackPanel">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
          </Setter>
        </Style>
      </StackPanel.Styles>

      <TextBlock HorizontalAlignment="Center" Text="Save Drawing actions can be used to export drawings in various formats." />
      <TextBlock HorizontalAlignment="Center" Text="To get started, create a new Save Drawing Action." />
      <Button Width="350" Margin="10" HorizontalAlignment="Center"
              HorizontalContentAlignment="Center"
              Command="{Binding AddNewSaveDrawingItemCommand}"
              Content="New Save Drawing Action" />
    </StackPanel>

    <Grid Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding SaveDrawingListHasItems}">
      <Grid.Styles>
        <Style Selector="Grid">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
          </Setter>
        </Style>
      </Grid.Styles>

      <!--  General Settings Column  -->
      <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, *">
        <Label Grid.Row="0" Classes="h2" Content="General Settings" />
        <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Set the main properties of the Save Drawing job." />
        <Grid Grid.Row="4" ColumnDefinitions="120, 10, 25, 5, *" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, Auto, Auto">
          <!--  Job Name  -->
          <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="Job Name" />
          <TextBox Name="TextBox_JobName" Grid.Row="0" Grid.Column="4"
                   Text="{Binding SelectedSaveDrawingItem.JobName}"
                   ToolTip.Tip="{Binding SelectedSaveDrawingItem.JobName}" />
          <!--  Description  -->
          <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Content="Description" />
          <TextBox Grid.Row="2" Grid.Column="4" Height="90"
                   AcceptsReturn="True"
                   Text="{Binding SelectedSaveDrawingItem.Description}"
                   TextWrapping="Wrap" />
          <!--  Filename  -->
          <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Content="Filename" />
          <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding SelectedSaveDrawingItem.FileName}" />
          <!--  Save Location  -->
          <Label Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Content="Save Location" />
          <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding SelectedSaveDrawingItem.SaveLocation}" />
          <!--  Sheets Filter  -->
          <Label Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Content="Sheets Filter" />
          <TextBox Grid.Row="8" Grid.Column="4" Text="{Binding SelectedSaveDrawingItem.SheetsFilter}" />
          <!--  Single PDF  -->
          <Label Grid.Row="10" Grid.Column="2" VerticalAlignment="Center"
                 Classes="icon-only icon-outline subtle-hover" Content="&#xE3E8;"
                 ToolTip.Tip="When saving a PDF save all sheets to a single PDF" />
          <CheckBox Grid.Row="10" Grid.Column="4" Content="Single PDF" IsChecked="{Binding SelectedSaveDrawingItem.SinglePdf}" />
          <!--  Single eDrawing  -->
          <Label Grid.Row="11" Grid.Column="2" VerticalAlignment="Center"
                 Classes="icon-only icon-outline subtle-hover" Content="&#xE3E8;"
                 ToolTip.Tip="When saving an eDrawing save all sheets to a single eDrawing" />
          <CheckBox Grid.Row="11" Grid.Column="4" Content="Single Drawing" IsChecked="{Binding SelectedSaveDrawingItem.SingleEDrawing}" />
          <!--  Single DWG/DF  -->
          <Label Grid.Row="12" Grid.Column="2" VerticalAlignment="Center"
                 Classes="icon-only icon-outline subtle-hover" Content="&#xE3E8;"
                 ToolTip.Tip="When saving a DWG or DXF save all sheets to a single file" />
          <CheckBox Grid.Row="12" Grid.Column="4" Content="Single DWG/DXF" IsChecked="{Binding SelectedSaveDrawingItem.SingleDwgDxf}" />
        </Grid>
      </Grid>

      <!--  Details Column  -->
      <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, *, 10, 40">
        <Label Grid.Row="0" Classes="h2" Content="Save As Formats" />
        <TextBlock Grid.Row="2" Margin="0,-10,0,0" Text="Select all the formats you wish to export the drawing files to." TextWrapping="Wrap" />

        <!--  Export Formats  -->
        <ScrollViewer Grid.Row="4">
          <ItemsControl ItemsSource="{Binding SelectedSaveDrawingItem.ExportFormats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Key}" IsChecked="{Binding Value}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!--  Save and Cancel state Button  -->
        <StackPanel Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Opacity="{Binding SelectedSaveDrawingItem.HasChanged, FallbackValue=0}"
                    Orientation="Horizontal" Spacing="10">
          <!--
            FallbackValue = 绑定失败时的 “备胎值” ，当绑定找不到对象、找不到值、或者值为 null 时 → 自动使用 FallbackValue 指定的值。
            场景 1：绑定对象可能为 null                      例如：SelectedPrintListItem 没选中时 = null → 便用 FallbackValue 给一个默认值
            场景 2：界面设计时（Designer 预览）              Designer 里没有 DataContext → 绑定全部失败 → 使用 FallbackValue 让界面显示正常
            场景 3：值类型不能为 null（bool /int/double）    如果绑定的是 bool，但对象是 null → 无法转换 → 使用 FallbackValue 提供默认值
          -->
          <!--  注意：WPF 与 Avalonia 的 IsVisible 不能绑定动画。Avalonia已经内置了 BoolToDouble值转换器，因此上面的 Opacity 可以直接绑定 HasChanged 布尔值  -->
          <StackPanel.Styles>
            <Style Selector="StackPanel">
              <Setter Property="Transitions">
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
              </Setter>
            </Style>
          </StackPanel.Styles>
          <Button Width="70" HorizontalContentAlignment="Center" Classes="success"
                  Command="{Binding SaveSaveDrawingItemCommand}"
                  Content="Save" />
          <Button Width="70" HorizontalContentAlignment="Center" Classes="outline"
                  Command="{Binding CancelSaveDrawingItemCommand}"
                  Content="Cancel" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>

</UserControl>