<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

  <Color x:Key="EffectShadowColor">Black</Color>

  <DropShadowEffect x:Key="EffectShadow1" BlurRadius="5" OffsetX="0"
                    OffsetY="1" Opacity=".2"
                    Color="{StaticResource EffectShadowColor}" />
  <DropShadowEffect x:Key="EffectShadow2" BlurRadius="8" OffsetX="0"
                    OffsetY="1.5" Opacity=".2"
                    Color="{StaticResource EffectShadowColor}" />
  <DropShadowEffect x:Key="EffectShadow3" BlurRadius="14" OffsetX="0"
                    OffsetY="4.5" Opacity=".2"
                    Color="{StaticResource EffectShadowColor}" />
  <DropShadowEffect x:Key="EffectShadow4" BlurRadius="25" OffsetX="0"
                    OffsetY="8" Opacity=".2"
                    Color="{StaticResource EffectShadowColor}" />
  <DropShadowEffect x:Key="EffectShadow5" BlurRadius="35" OffsetX="0"
                    OffsetY="13" Opacity=".2"
                    Color="{StaticResource EffectShadowColor}" />

</ResourceDictionary>